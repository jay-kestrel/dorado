  "source_script_lines": [
    "\"\"\"Check the actual timed-region scope; profiles are not performance-gate samples.\"\"\"",
    "import cProfile",
    "import json",
    "from pathlib import Path",
    "import pstats",
    "import sys",
    "from unittest.mock import patch",
    "",
    "import numpy as np",
    "",
    "sys.path.insert(0, str(Path.cwd()))",
    "from benchmarks import bench_routing as bench",
    "from benchmarks.numpy_stepper import make_stepper",
    "from dorado import lagrangian_walker as lw",
    "",
    "",
    "def profile_backend(workload, backend):",
    "    particles = bench.stage_particles(workload, 2500, backend, 0)",
    "    profiler = cProfile.Profile()",
    "    np.random.seed(0)",
    "    if backend == \"numpy\":",
    "        with patch.object(lw, \"particle_stepper\", make_stepper(particles)):",
    "            profiler.runcall(bench.route, particles, 50)",
    "    else:",
    "        profiler.runcall(bench.route, particles, 50)",
    "    stats = pstats.Stats(profiler)",
    "    appends = [value for key, value in stats.stats.items()",
    "               if key[2] == \"<method 'append' of 'list' objects>\"]",
    "    assert len(appends) == 1",
    "    callers = [{\"function\": key[2], \"calls\": value[1]}",
    "               for key, value in appends[0][4].items()]",
    "    history_appends = sum(row[\"calls\"] for row in callers",
    "                          if row[\"function\"] == \"run_iteration\")",
    "    iterations = [value[1] for key, value in stats.stats.items()",
    "                  if key[2] == \"run_iteration\"]",
    "    assert history_appends == 625000 and iterations == [50], (backend, callers, iterations)",
    "    schema = {}",
    "    for key, rows in particles.walk_data.items():",
    "        values = np.asarray(rows)",
    "        schema[key] = {\"shape\": list(values.shape), \"dtype\": str(values.dtype)}",
    "        assert values.shape == (2500, 51)",
    "    return {\"backend\": backend, \"total_list_appends\": appends[0][1],",
    "            \"history_list_appends\": history_appends, \"append_callers\": callers,",
    "            \"run_iteration_calls\": iterations[0], \"walk_data_schema\": schema}",
    "",
    "",
    "def main():",
    "    report = {",
    "        \"metadata\": bench.metadata(),",
    "        \"command\": \"python /home/user/work/perf_scope.py (DORADO_BACKEND/DORADO_COBOL unset)\",",
    "        \"source_script_lines\": Path(__file__).read_text().splitlines(),",
    "        \"results\": [profile_backend(bench.load_workload(\"anuga\"), backend)",
    "                    for backend in (\"python\", \"numpy\", \"rust\")],",
    "    }",
    "    Path(\"benchmarks/results/post-port-scope.json\").write_text(",
    "        json.dumps(report, indent=2, allow_nan=False) + \"\\n\")",
    "    print(json.dumps(report[\"results\"], indent=2))",
    "",
    "",
    "if __name__ == \"__main__\":",
    "    main()"
  ],
