  "source_script_lines": [
    "\"\"\"Evidence-only probes; run from repository root, never edit backend sources.\"\"\"",
    "import copy",
    "import cProfile",
    "import hashlib",
    "import json",
    "import os",
    "from pathlib import Path",
    "import pstats",
    "import statistics",
    "import subprocess",
    "import sys",
    "import time",
    "from unittest.mock import patch",
    "",
    "import numpy as np",
    "",
    "sys.path.insert(0, str(Path.cwd()))",
    "from benchmarks import bench_routing as bench",
    "from dorado import _native",
    "",
    "",
    "OUT = Path(\"benchmarks/results\")",
    "REPEATS = 3",
    "SEED = 0",
    "",
    "",
    "def fresh(staged):",
    "    particles = copy.deepcopy(staged)",
    "    np.random.seed(SEED)",
    "    return particles",
    "",
    "",
    "def digest(walk):",
    "    return hashlib.sha256(json.dumps(walk, sort_keys=True, allow_nan=False).encode()).hexdigest()",
    "",
    "",
    "def scale_field(name):",
    "    workload = bench.load_workload(name)",
    "    staged = bench.stage_particles(workload, 5000, \"rust\", SEED)",
    "    rows, walks = [], []",
    "    for threads in (1, 8):",
    "        staged.n_threads = threads",
    "        elapsed, moved = bench.measure(staged, workload.steps, REPEATS, SEED)",
    "        particles = fresh(staged)",
    "        bench.route(particles, workload.steps)",
    "        walks.append(particles.walk_data)",
    "        median = statistics.median(elapsed)",
    "        rows.append({",
    "            \"n_threads\": threads, \"seconds\": elapsed, \"median_seconds\": median,",
    "            \"microseconds_per_attempted_step\": median * 1e6 / (5000 * workload.steps),",
    "            \"attempted_steps_per_second\": 5000 * workload.steps / median,",
    "            \"appended_steps\": moved, \"walk_data_sha256\": digest(particles.walk_data),",
    "        })",
    "    equal = walks[0] == walks[1]",
    "    assert equal, name",
    "    return {",
    "        \"workload\": name, \"particles\": 5000, \"steps\": workload.steps,",
    "        \"seed\": SEED, \"repeats\": REPEATS, \"data_sha256\": workload.data_sha256,",
    "        \"rows\": rows, \"walk_data_equal\": equal,",
    "        \"eight_thread_speedup\": rows[0][\"median_seconds\"] / rows[1][\"median_seconds\"],",
    "    }",
    "",
    "",
    "def profile_once(staged, steps, index):",
    "    particles = fresh(staged)",
    "    profiler = cProfile.Profile()",
    "    start = time.perf_counter()",
    "    profiler.enable()",
    "    bench.route(particles, steps)",
    "    profiler.disable()",
    "    elapsed = time.perf_counter() - start",
    "    profiler.dump_stats(f\"/home/user/work/perf-native-{index}.pstats\")",
    "    stats = pstats.Stats(profiler)",
    "    records = [",
    "        {\"file\": key[0], \"line\": key[1], \"function\": key[2],",
    "         \"primitive_calls\": value[0], \"calls\": value[1],",
    "         \"self_seconds\": value[2], \"cumulative_seconds\": value[3]}",
    "        for key, value in stats.stats.items()",
    "    ]",
    "    native = [r for r in records if r[\"file\"] == \"~\" and \"step_particles\" in r[\"function\"]]",
    "    assert len(native) == 1 and native[0][\"calls\"] == steps, native",
    "    native_seconds = native[0][\"cumulative_seconds\"]",
    "    return {",
    "        \"wall_seconds\": elapsed, \"pstats_total_seconds\": stats.total_tt,",
    "        \"native_call\": native[0], \"native_call_seconds\": native_seconds,",
    "        \"outside_native_call_seconds\": elapsed - native_seconds,",
    "        \"appended_steps\": bench.appended_steps(particles),",
    "        \"functions_by_self_time\": sorted(records, key=lambda r: r[\"self_seconds\"], reverse=True),",
    "    }",
    "",
    "",
    "def boundary_once(staged, steps):",
    "    particles = fresh(staged)",
    "    original = _native.step_particles",
    "    durations = []",
    "",
    "    def timed_call(*args, **kwargs):",
    "        start = time.perf_counter()",
    "        result = original(*args, **kwargs)",
    "        durations.append(time.perf_counter() - start)",
    "        return result",
    "",
    "    with patch.object(_native, \"step_particles\", timed_call):",
    "        start = time.perf_counter()",
    "        bench.route(particles, steps)",
    "        elapsed = time.perf_counter() - start",
    "    assert len(durations) == steps",
    "    native_seconds = sum(durations)",
    "    return {",
    "        \"wall_seconds\": elapsed, \"native_call_seconds\": native_seconds,",
    "        \"outside_native_call_seconds\": elapsed - native_seconds,",
    "        \"native_calls\": len(durations), \"per_call_seconds\": durations,",
    "        \"appended_steps\": bench.appended_steps(particles),",
    "    }",
    "",
    "",
    "def attribution():",
    "    workload = bench.load_workload(\"anuga\")",
    "    staged = bench.stage_particles(workload, 2500, \"rust\", SEED)",
    "    elapsed, moved = bench.measure(staged, workload.steps, REPEATS, SEED)",
    "    return {",
    "        \"workload\": \"anuga\", \"particles\": 2500, \"steps\": workload.steps,",
    "        \"seed\": SEED, \"n_threads\": 1, \"repeats\": REPEATS,",
    "        \"attempted_particle_steps\": 2500 * workload.steps,",
    "        \"unprofiled_control_seconds\": elapsed, \"unprofiled_appended_steps\": moved,",
    "        \"cprofile\": [profile_once(staged, workload.steps, i) for i in range(REPEATS)],",
    "        \"boundary_wall_clock\": [boundary_once(staged, workload.steps) for _ in range(REPEATS)],",
    "        \"limitations\": [",
    "            \"cProfile disproportionately inflates Python work; use boundary wall-clock cross-check for the proposal.\",",
    "            \"step_particles is the whole opaque PyO3 call, including validation, RNG growth, result conversion and dispatch; not just pure Rust stepping.\",",
    "            \"Outside-call time includes Python assembly, orchestration, argument/result conversion outside PyO3, plus measurement overhead.\",",
    "            \"Same fresh-copy semantics as bench_routing: lazy field/RNG initialization on first timed iteration is included; disposable warmup does not warm the measured instance.\",",
    "            \"No profiled result replaces the original unprofiled gate measurements.\",",
    "        ],",
    "    }",
    "",
    "",
    "def main():",
    "    assert not os.environ.get(\"DORADO_BACKEND\") and not os.environ.get(\"DORADO_COBOL\")",
    "    report = {",
    "        \"schema_version\": 1, \"metadata\": bench.metadata(),",
    "        \"hardware_lscpu\": subprocess.check_output([\"lscpu\"], text=True),",
    "        \"kernel_version\": _native.kernel_version(),",
    "        \"source_script_lines\": Path(__file__).read_text().splitlines(),",
    "        \"reproduce\": \"From the repo root, extract source_script_lines with newline joins to scratch, activate the perf venv, unset DORADO_BACKEND/DORADO_COBOL, then run that scratch file.\",",
    "        \"scaling\": [scale_field(name) for name in (\"rcm\", \"anuga\")],",
    "        \"attribution\": attribution(),",
    "    }",
    "    path = OUT / \"post-port-followup.json\"",
    "    path.write_text(json.dumps(report, indent=2, allow_nan=False) + \"\\n\")",
    "    for row in report[\"scaling\"]:",
    "        print(\"SCALING\", row[\"workload\"], row[\"eight_thread_speedup\"], row[\"walk_data_equal\"])",
    "    for mode in (\"cprofile\", \"boundary_wall_clock\"):",
    "        for row in report[\"attribution\"][mode]:",
    "            print(mode, row[\"wall_seconds\"], row[\"native_call_seconds\"], row[\"outside_native_call_seconds\"])",
    "    print(path)",
    "",
    "",
    "if __name__ == \"__main__\":",
    "    main()"
  ],
