  "source_script_lines": [
    "\"\"\"Record numeric parity from the unchanged gate tests, plus local log evidence.\"\"\"",
    "import json",
    "from pathlib import Path",
    "import subprocess",
    "import sys",
    "from unittest.mock import patch",
    "",
    "sys.path[:0] = [str(Path.cwd()), str(Path.cwd() / \"tests\")]",
    "import test_make_weight_fused as weight_tests",
    "",
    "",
    "WORK = Path(\"/home/user/work\")",
    "rows = []",
    "original = weight_tests._assert_parity",
    "",
    "",
    "def record_parity(fused, reference, context):",
    "    value = original(fused, reference, context)",
    "    rows.append({\"context\": context, \"max_relative_difference\": value})",
    "    return value",
    "",
    "",
    "def main():",
    "    with patch.object(weight_tests, \"_assert_parity\", record_parity):",
    "        weight_tests.test_parity_bundled_rcm()",
    "        weight_tests.test_parity_bundled_anuga()",
    "        for stranding in (\"park\", \"none\"):",
    "            for seed in (0, 1, 2):",
    "                weight_tests.test_parity_synthetic_small(seed, stranding)",
    "        for gamma in (0.0, 1.0):",
    "            weight_tests.test_parity_gamma_extremes(gamma)",
    "        weight_tests.test_parity_synthetic_1000x2000()",
    "    metrics = [json.loads(line.split(\"EQUIVALENCE \", 1)[1])",
    "               for line in (WORK / \"perf-equivalence.log\").read_text().splitlines()",
    "               if \"EQUIVALENCE \" in line]",
    "    assert len(metrics) == 3 and len(rows) == 11",
    "    report = {",
    "        \"source_revision\": subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip(),",
    "        \"policy\": \"Owner-disabled Actions: local verification only; no fresh CI pass claimed.\",",
    "        \"equivalence_command\": \"python -m pytest -q -s tests/test_equivalence.py\",",
    "        \"equivalence_summary\": (WORK / \"perf-equivalence.log\").read_text().splitlines()[-1],",
    "        \"equivalence_metrics\": metrics,",
    "        \"weight_parity\": rows,",
    "        \"weight_memory\": [json.loads((WORK / f\"perf-weight-{name}.log\").read_text().splitlines()[-1])",
    "                          for name in (\"reference\", \"fused\")],",
    "        \"weight_memory_commands\": [f\"python tests/_weight_reference.py {name} 1000 2000\"",
    "                                   for name in (\"reference\", \"fused\")],",
    "        \"full_pytest_command\": \"python -m pytest -q\",",
    "        \"full_pytest_summary\": (WORK / \"perf-full-pytest.log\").read_text().splitlines()[-1],",
    "        \"ruff_command\": \"python -m ruff check dorado tests benchmarks\",",
    "        \"ruff_output\": (WORK / \"perf-ruff.log\").read_text().strip(),",
    "        \"cargo_command\": \"cargo test --manifest-path rust/Cargo.toml\",",
    "        \"cargo_summaries\": [line for line in (WORK / \"perf-cargo-test.log\").read_text().splitlines()",
    "                            if line.startswith(\"test result:\")],",
    "        \"build_command\": \"maturin develop --release\",",
    "        \"build_log_tail\": (WORK / \"perf-build.log\").read_text().splitlines()[-8:],",
    "        \"source_script_lines\": Path(__file__).read_text().splitlines(),",
    "    }",
    "    Path(\"benchmarks/results/post-port-verification.json\").write_text(",
    "        json.dumps(report, indent=2, allow_nan=False) + \"\\n\")",
    "    print(json.dumps(rows, indent=2))",
    "",
    "",
    "if __name__ == \"__main__\":",
    "    main()"
  ]
}
